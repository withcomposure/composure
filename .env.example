# Composure environment variables
# Copy this file to .env and adjust values for your environment.

# -----------------------------------------------------------------------------
# Backend / API
# -----------------------------------------------------------------------------

# Runtime mode: development|production|test
NODE_ENV=development

# Backend HTTP port (also used by docker-compose host port mapping)
PORT=8080

# Root data directory (assets, repos, etc.)
DATA_DIR=./data

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5433/composure

# Optional explicit test database URL for tests
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/composure_test

# Optional templates directory (defaults to the repository templates directory)
TEMPLATES_DIR=

# Optional comma-separated list of trusted browser origins for cross-origin
# HTTP API (CORS) and collaboration websocket access.
# If left blank, localhost:5173 and 127.0.0.1:5173 are allowed.
# In production split deployments, set this to your frontend origin.
# Example: https://composure.pages.dev,https://yourdomain.com
CORS_ORIGIN=

# API mount prefix before the version segment (/v1).
# For example, /my/api gives /my/api/v1/... and / gives /v1/...
API_BASE_PATH=/api

# Whether backend should serve frontend static files from frontend/dist.
# Keep true for all-in-one deploys, set false for split frontend deploys.
SERVE_FRONTEND=true

# Comma-separated compiler worker URLs used by compile dispatch
# Example: http://127.0.0.1:4000,http://127.0.0.1:4001
COMPILERS=http://127.0.0.1:4000

# Timeout (ms) for backend requests to compiler workers
COMPILER_TIMEOUT_MS=45000

# Maximum allowed profile image payload size in bytes (default 262144 = 256 KB)
MAX_AVATAR_IMAGE_BYTES=262144

# -----------------------------------------------------------------------------
# Compiler worker service
# -----------------------------------------------------------------------------

# --- Per-compiler process settings ---
# These should probably be set per process at runtime, not in your .env file:
#   PORT is the HTTP port the worker listens on.
#   COMPILE_DIR is the worker's output directory for compile artifacts.
# Examples:
#   PORT=4001 COMPILE_DIR=./data/compiles/compiler-1 node worker.js
#   PORT=4002 COMPILE_DIR=./data/compiles/compiler-2 node worker.js

# Read-only assets directory mounted into the compiler
ASSETS_DIR=./data/assets

# Cache directories for Tectonic and Typst
TECTONIC_CACHE=./data/caches/tectonic
TYPST_CACHE=./data/caches/typst

# Optional base64-encoded Yjs document update used when compile payload omits one
DEFAULT_DOCUMENT_UPDATE_BASE64=

# Timeout (ms) for a single compile request
COMPILE_TIMEOUT_MS=60000

# Max number of projects compiled concurrently by a worker
# Default behavior when unset is based on CPU count.
MAX_CONCURRENT_PROJECTS=4

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------

# Optional explicit collaboration websocket URL.
# Optional frontend API location.
# You can provide either:
#   - absolute origin (e.g. https://api.example.com or https://api.example.com/my/api)
#   - same-origin base (e.g. /my/api)
# If unset, defaults to same-origin base /api.
# Should agree with whatever is set in API_BASE_PATH for the backend.
# For split frontend/api deployments, set an absolute URL pointing at your API.
VITE_API_URL=

# -----------------------------------------------------------------------------
# Docker Compose host overrides
# -----------------------------------------------------------------------------

# Host port bound to the postgres container (docker-compose.yml)
PG_PORT=5433
