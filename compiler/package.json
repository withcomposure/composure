    "eslint": "^9.39.4",
    "eslint-plugin-check-file": "^3.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.1"
  }
